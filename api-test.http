### 12. 비워진 장바구니 확인
GET {{baseUrl}}/cart/1
Accept: application/json
Authorization: Bearer {{accessToken}}

> {%
  console.log("=== 비워진 장바구니 확인 ===");
  if (response.status === 200) {
    console.log("상품 개수:", response.body.totalItemCount);
    console.log("총 가격:", response.body.totalPrice);
    if (response.body.totalItemCount === 0) {
      console.log("✅ 장바구니가 성공적으로 비워졌습니다.");
    }
  }
%}

### ========== 에러 테스트 ==========

### 13. 존재하지 않는 상품 추가 (에러 테스트)
POST {{baseUrl}}/cart/1/items
Content-Type: {{contentType}}
Authorization: Bearer {{accessToken}}

{
  "goodsNo": 999,
  "itemQty": 1,
  "price": 10000
}

> {%
  console.log("=== 존재하지 않는 상품 추가 테스트 ===");
  console.log("Status:", response.status);
  if (response.status === 400) {
    console.log("✅ 예상된 에러 응답:", response.body);
  } else {
    console.log("❌ 예상과 다른 응답");
  }
%}

