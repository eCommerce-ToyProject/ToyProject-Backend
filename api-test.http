### 장바구니 API 테스트

### 변수 설정
@baseUrl = http://localhost:8080
@contentType = application/json

### ========== 로그인 및 인증 ==========

### 1. 로그인 - jammykim1 계정 (쿠키 자동 저장)
POST {{baseUrl}}/members/sign-in
Content-Type: {{contentType}}

{
  "id": "jammykim1",
  "password": "jammykim0603!"
}

> {%
  console.log("=== 로그인 응답 분석 ===");
  console.log("Status Code:", response.status);
  
  // 쿠키에서 토큰 추출
  if (response.headers && response.headers["Set-Cookie"]) {
    const cookies = response.headers["Set-Cookie"];
    console.log("Set-Cookie 헤더:", cookies);
    
    const cookieArray = Array.isArray(cookies) ? cookies : [cookies];
    
    cookieArray.forEach(cookie => {
      // accessToken 추출
      if (cookie.includes("accessToken=")) {
        const tokenMatch = cookie.match(/accessToken=([^;]+)/);
        if (tokenMatch && tokenMatch[1]) {
          client.global.set("accessToken", tokenMatch[1]);
          console.log("✅ Access Token 저장됨");
        }
      }
      
      // refreshToken 추출
      if (cookie.includes("refreshToken=")) {
        const tokenMatch = cookie.match(/refreshToken=([^;]+)/);
        if (tokenMatch && tokenMatch[1]) {
          client.global.set("refreshToken", tokenMatch[1]);
          console.log("✅ Refresh Token 저장됨");
        }
      }
    });
  }
  
  if (response.status === 200) {
    console.log("✅ 로그인 성공");
  } else {
    console.log("❌ 로그인 실패");
  }
%}

### 1-1. 로그인 상태 확인
GET {{baseUrl}}/members/loginCheck
Authorization: Bearer {{accessToken}}

> {%
  console.log("로그인 체크 응답:", response.body);
  if (response.status === 200 && response.body) {
    client.global.set("currentUserId", response.body);
    console.log("✅ 현재 로그인된 사용자:", response.body);
  }
%}

### ========== 장바구니 API 테스트 ==========

### 2. 장바구니 조회 (회원번호: 1)
GET {{baseUrl}}/cart/1
Accept: application/json
Authorization: Bearer {{accessToken}}

> {%
  console.log("=== 장바구니 조회 ===");
  console.log("Status:", response.status);
  console.log("Response:", JSON.stringify(response.body, null, 2));
  
  if (response.status === 200) {
    console.log("✅ 장바구니 조회 성공");
    if (response.body && response.body.cartItems && response.body.cartItems.length > 0) {
      client.global.set("cartItemId", response.body.cartItems[0].cartItemId);
      console.log("📦 첫 번째 장바구니 아이템 ID 저장:", response.body.cartItems[0].cartItemId);
    }
  }
%}

### 3. 장바구니에 상품 추가 (유니클로 티셔츠)
POST {{baseUrl}}/cart/1/items
Content-Type: {{contentType}}
Authorization: Bearer {{accessToken}}

{
  "goodsNo": 1,
  "itemQty": 2,
  "price": 19900
}

> {%
  console.log("=== 상품 추가 (유니클로 티셔츠) ===");
  console.log("Status:", response.status);
  console.log("Response:", JSON.stringify(response.body, null, 2));
  
  if (response.status === 200) {
    console.log("✅ 유니클로 티셔츠 추가 성공");
    if (response.body && response.body.cartItems && response.body.cartItems.length > 0) {
      // 가장 마지막 아이템의 ID 저장
      const lastItem = response.body.cartItems[response.body.cartItems.length - 1];
      client.global.set("cartItemId", lastItem.cartItemId);
      console.log("📦 장바구니 아이템 ID 저장:", lastItem.cartItemId);
    }
  } else {
    console.log("❌ 상품 추가 실패:", response.body);
  }
%}

### 4. 장바구니에 다른 상품 추가 (나이키 신발)
POST {{baseUrl}}/cart/1/items
Content-Type: {{contentType}}
Authorization: Bearer {{accessToken}}

{
  "goodsNo": 4,
  "itemQty": 1,
  "price": 159000
}

> {%
  console.log("=== 상품 추가 (나이키 신발) ===");
  console.log("Status:", response.status);
  console.log("Response:", JSON.stringify(response.body, null, 2));
  
  if (response.status === 200) {
    console.log("✅ 나이키 신발 추가 성공");
    console.log("총 상품 개수:", response.body.totalItemCount);
    console.log("총 가격:", response.body.totalPrice);
  } else {
    console.log("❌ 상품 추가 실패:", response.body);
  }
%}

### 5. 같은 상품 다시 추가 (수량 증가 테스트)
POST {{baseUrl}}/cart/1/items
Content-Type: {{contentType}}
Authorization: Bearer {{accessToken}}

{
  "goodsNo": 1,
  "itemQty": 1,
  "price": 19900
}

> {%
  console.log("=== 같은 상품 재추가 ===");
  if (response.status === 200) {
    console.log("✅ 기존 상품 수량 증가 성공");
    const tshirtItem = response.body.cartItems.find(item => item.goodsNo === 1);
    if (tshirtItem) {
      console.log("유니클로 티셔츠 최종 수량:", tshirtItem.itemQty);
    }
  }
%}

### 6. 장바구니 상품 수량 수정
PUT {{baseUrl}}/cart/1/items/{{cartItemId}}
Content-Type: {{contentType}}
Authorization: Bearer {{accessToken}}

{
  "itemQty": 5
}

> {%
  console.log("=== 상품 수량 수정 ===");
  console.log("Status:", response.status);
  if (response.status === 200) {
    console.log("✅ 상품 수량 수정 성공");
    console.log("수정 후 총 가격:", response.body.totalPrice);
  } else {
    console.log("❌ 상품 수량 수정 실패:", response.body);
  }
%}

### 7. 장바구니 상품 개수 조회
GET {{baseUrl}}/cart/1/count
Accept: application/json
Authorization: Bearer {{accessToken}}

> {%
  console.log("=== 장바구니 상품 개수 조회 ===");
  console.log("Status:", response.status);
  console.log("상품 개수:", response.body);
  if (response.status === 200) {
    console.log("✅ 상품 개수 조회 성공:", response.body + "개");
  }
%}

### 8. 장바구니 상품 삭제
DELETE {{baseUrl}}/cart/1/items/{{cartItemId}}
Authorization: Bearer {{accessToken}}

> {%
  console.log("=== 상품 삭제 ===");
  console.log("Status:", response.status);
  if (response.status === 200) {
    console.log("✅ 상품 삭제 성공");
    console.log("삭제 후 총 상품 개수:", response.body.totalItemCount);
  } else {
    console.log("❌ 상품 삭제 실패:", response.body);
  }
%}

