### ========== 로그아웃 ==========

### 16. 로그아웃
POST {{baseUrl}}/members/logout

> {%
  if (response.status === 200) {
    client.global.clear("accessToken");
    client.global.clear("refreshToken");
    client.global.clear("currentUserId");
    client.global.clear("cartItemId");
    client.global.clear("member2CartItemId");
    console.log("✅ 로그아웃 완료. 모든 저장된 데이터가 삭제되었습니다.");
  }
%}
