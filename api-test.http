### 변수 설정
@baseUrl = http://localhost:8080
@contentType = application/json

### 1. 로그인 - 쿠키로 토큰 저장하는 방식 (올바른 필드명)
POST {{baseUrl}}/members/sign-in
Content-Type: {{contentType}}

{
  "id": "jammykim1",
  "password": "jammykim0603!"
}

> {%
  console.log("=== 로그인 응답 분석 ===");
  console.log("Status Code:", response.status);
  console.log("Response Headers:", JSON.stringify(response.headers, null, 2));
  
  // 쿠키에서 토큰 추출
  if (response.headers && response.headers["Set-Cookie"]) {
    const cookies = response.headers["Set-Cookie"];
    console.log("Set-Cookie 헤더:", cookies);
    
    // 배열인지 문자열인지 확인
    const cookieArray = Array.isArray(cookies) ? cookies : [cookies];
    
    cookieArray.forEach(cookie => {
      console.log("Cookie:", cookie);
      
      // accessToken 추출
      if (cookie.includes("accessToken=")) {
        const tokenMatch = cookie.match(/accessToken=([^;]+)/);
        if (tokenMatch && tokenMatch[1]) {
          client.global.set("accessToken", tokenMatch[1]);
          console.log("✅ Access Token 저장됨 (쿠키에서)");
        }
      }
      
      // refreshToken 추출
      if (cookie.includes("refreshToken=")) {
        const tokenMatch = cookie.match(/refreshToken=([^;]+)/);
        if (tokenMatch && tokenMatch[1]) {
          client.global.set("refreshToken", tokenMatch[1]);
          console.log("✅ Refresh Token 저장됨 (쿠키에서)");
        }
      }
    });
    
    // 저장 확인
    const savedAccessToken = client.global.get("accessToken");
    const savedRefreshToken = client.global.get("refreshToken");
    
    if (savedAccessToken) {
      console.log("🔑 Access Token 저장 확인:", savedAccessToken.substring(0, 20) + "...");
    }
    if (savedRefreshToken) {
      console.log("🔑 Refresh Token 저장 확인:", savedRefreshToken.substring(0, 20) + "...");
    }
    
  } else {
    console.log("❌ Set-Cookie 헤더가 없습니다.");
  }
  
  if (response.status === 200) {
    console.log("✅ 로그인 성공");
  } else {
    console.log("❌ 로그인 실패. 응답:", JSON.stringify(response.body, null, 2));
  }
%}

### 1-1. 다른 계정으로 로그인 테스트
POST {{baseUrl}}/members/sign-in
Content-Type: {{contentType}}

{
  "id": "jane456",
  "password": "password123"
}

### 1-2. 관리자 계정으로 로그인 테스트
POST {{baseUrl}}/members/sign-in
Content-Type: {{contentType}}

{
  "id": "admin",
  "password": "admin123"
}

### 2. 로그인 상태 확인 (저장된 토큰 사용)
GET {{baseUrl}}/members/loginCheck
Authorization: Bearer {{accessToken}}

### 3. 저장된 토큰 정보 확인
GET {{baseUrl}}/api/chat/test/health

> {%
  console.log("=== 현재 저장된 토큰 정보 ===");
  const accessToken = client.global.get("accessToken");
  const refreshToken = client.global.get("refreshToken");
  
  console.log("Access Token:", accessToken ? "저장됨 (" + accessToken.length + "자)" : "없음");
  console.log("Refresh Token:", refreshToken ? "저장됨 (" + refreshToken.length + "자)" : "없음");
  
  if (accessToken) {
    console.log("Access Token 시작:", accessToken.substring(0, 30) + "...");
  }
%}

### 4. 토큰 갱신 (refreshToken 사용)
POST {{baseUrl}}/members/reissuanceAccessToken
Content-Type: {{contentType}}
Cookie: refreshToken={{refreshToken}}

> {%
  console.log("토큰 갱신 응답 상태:", response.status);
  
  // 새로운 토큰을 쿠키에서 추출
  if (response.headers && response.headers["Set-Cookie"]) {
    const cookies = response.headers["Set-Cookie"];
    const cookieArray = Array.isArray(cookies) ? cookies : [cookies];
    
    cookieArray.forEach(cookie => {
      if (cookie.includes("accessToken=")) {
        const tokenMatch = cookie.match(/accessToken=([^;]+)/);
        if (tokenMatch && tokenMatch[1]) {
          client.global.set("accessToken", tokenMatch[1]);
          console.log("✅ 새로운 Access Token 저장됨");
        }
      }
      
      if (cookie.includes("refreshToken=")) {
        const tokenMatch = cookie.match(/refreshToken=([^;]+)/);
        if (tokenMatch && tokenMatch[1]) {
          client.global.set("refreshToken", tokenMatch[1]);
          console.log("✅ 새로운 Refresh Token 저장됨");
        }
      }
    });
  }
%}

### ====== 라이브 방송 관련 API (인증 토큰 사용) ======

### 5. 라이브 방송 생성 (인증 필요)
POST {{baseUrl}}/api/live
Content-Type: {{contentType}}
Authorization: Bearer {{accessToken}}

{
  "hostMemNo": 1,
  "catCd": 1,
  "title": "HTTP Client로 생성한 테스트 방송",
  "startTime": "2024-12-16T15:00:00",
  "endTime": "2024-12-16T16:00:00"
}

> {%
  console.log("라이브 방송 생성 응답:", JSON.stringify(response.body, null, 2));
  
  if (response.status === 201 && response.body && response.body.liveNo) {
    client.global.set("liveNo", response.body.liveNo);
    console.log("✅ 라이브 방송 생성됨. Live No:", response.body.liveNo);
  } else if (response.status === 403) {
    console.log("❌ 권한 없음. 토큰이 올바른지 확인하세요.");
  } else {
    console.log("❌ 라이브 방송 생성 실패. 상태:", response.status);
  }
%}

### 6. 라이브 방송 시작
POST {{baseUrl}}/api/live/{{liveNo}}/start?hostMemNo=1
Authorization: Bearer {{accessToken}}

### 7. 라이브 방송 목록 조회
GET {{baseUrl}}/api/live?page=0&size=10
Authorization: Bearer {{accessToken}}

### 8. 라이브 방송 상세 조회
GET {{baseUrl}}/api/live/{{liveNo}}
Authorization: Bearer {{accessToken}}

### 9. 라이브 방송 종료
POST {{baseUrl}}/api/live/{{liveNo}}/end?hostMemNo=1
Authorization: Bearer {{accessToken}}

### ====== 채팅 관련 API ======

### 10. 채팅 기록 조회
GET {{baseUrl}}/api/chat/history/{{liveNo}}?page=0&size=20
Authorization: Bearer {{accessToken}}

### 11. 현재 접속자 수 조회
GET {{baseUrl}}/api/chat/usercount/{{liveNo}}

### 12. 현재 접속자 목록 조회
GET {{baseUrl}}/api/chat/users/{{liveNo}}
Authorization: Bearer {{accessToken}}

### ====== 회원 관련 API ======

