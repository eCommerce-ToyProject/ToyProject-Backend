### 10. 회원 2번에게 상품 추가
POST {{baseUrl}}/cart/2/items
Content-Type: {{contentType}}
Authorization: Bearer {{accessToken}}

{
  "goodsNo": 2,
  "itemQty": 1,
  "price": 89000
}

> {%
  console.log("=== 회원 2번 상품 추가 ===");
  if (response.status === 200) {
    console.log("✅ 회원 2번 상품 추가 성공");
    if (response.body.cartItems && response.body.cartItems.length > 0) {
      client.global.set("member2CartItemId", response.body.cartItems[0].cartItemId);
    }
  }
%}

### 11. 장바구니 전체 비우기
DELETE {{baseUrl}}/cart/1
Authorization: Bearer {{accessToken}}

